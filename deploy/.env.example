# Copy to /opt/stonks-market/.env on the VPS and fill in.

# --- image ---
# GitHub user/org that owns the repo, lowercase
GHCR_OWNER=your-github-user

# --- Traefik (match your existing Traefik setup) ---
DOMAIN=stonks.example.com
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=cf

# --- app runtime ---
# generate with: openssl rand -base64 32
NUXT_BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://stonks.example.com
