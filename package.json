{
  "name": "stonks-market",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:up": "podman compose up -d",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "auth:generate": "auth generate --config auth.cli.ts --output server/db/schema/auth.ts -y && eslint --fix server/db/schema/auth.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.25",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/hints": "1.1.5",
    "@nuxt/ui": "4.12.0",
    "@nuxtjs/better-auth": "0.3.17",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-bubble-menu": "^3.34.0",
    "@tiptap/extension-code": "^3.34.0",
    "@tiptap/extension-collaboration": "^3.34.0",
    "@tiptap/extension-drag-handle": "^3.34.0",
    "@tiptap/extension-drag-handle-vue-3": "^3.34.0",
    "@tiptap/extension-floating-menu": "^3.34.0",
    "@tiptap/extension-horizontal-rule": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-mention": "^3.34.0",
    "@tiptap/extension-node-range": "^3.34.0",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/markdown": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@tiptap/suggestion": "^3.34.0",
    "@tiptap/vue-3": "^3.34.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "better-auth": "1.7.25",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.15.0",
    "nuxt": "^4.6.4",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "yahoo-finance2": "4.0.6"
